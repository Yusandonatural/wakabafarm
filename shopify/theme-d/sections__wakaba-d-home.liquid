{%- comment -%}
  若葉農園 D案（競合研究版）トップページ用セクション
  坂ノ途中・ナチュラル・ハーモニーなど、自然栽培・有機野菜の宅配サイトを参考に、
  「はじめての人が迷わず申し込める」流れと「栽培基準をはっきり見せる」ことを重視した構成。
  文言・写真・今週のお野菜・プラン・声・質問はテーマエディタで編集できます。
{%- endcomment -%}
<style>
  .wkd{--g:#163729;--g2:#2A5A40;--leaf:#82BC3F;--leaf2:#4F7A22;--ink:#3E3A34;--mute:#77706A;--bg:#FFFFFF;--soft:#F6F4EE;--cream:#FBF6EC;--line:#E6E1D6;--carrot:#B85716;--mint:#EEF5E4;
    background:var(--bg);color:var(--ink);font-family:var(--font-body-family,'Noto Sans JP',sans-serif);--serif:var(--font-heading-family,'Shippori Mincho',serif);font-size:16px;line-height:1.9;letter-spacing:.03em}
  .wkd *{box-sizing:border-box}
  .wkd a{color:var(--g)}
  .wkd img{display:block;width:100%;height:100%;object-fit:cover}
  .wkd__in{max-width:1180px;margin:0 auto;padding:0 24px}
  .wkd__sec{padding:96px 0}
  .wkd__sec--soft{background:var(--soft)}
  .wkd__sec--cream{background:var(--cream)}
  .wkd__eyebrow{margin:0;font-size:13px;font-weight:700;letter-spacing:.16em;color:var(--leaf2)}
  .wkd__h1,.wkd__h2,.wkd__final h2{text-wrap:balance;word-break:auto-phrase}
  .wkd__h2{margin:8px 0 18px;font-family:var(--serif);font-weight:400;color:var(--g);font-size:clamp(26px,3.4vw,38px);line-height:1.5}
  .wkd__lead{margin:0 0 44px;max-width:700px;color:var(--mute)}
  .wkd__center{text-align:center}.wkd__center .wkd__lead{margin-left:auto;margin-right:auto}
  .wkd__btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:56px;padding:0 32px;border-radius:12px;background:var(--carrot);color:#fff!important;text-decoration:none;font-weight:700;font-size:17px;box-shadow:0 4px 0 #7E3A0C;transition:transform .15s,box-shadow .15s}
  .wkd__btn:hover{transform:translateY(2px);box-shadow:0 2px 0 #7E3A0C}
  .wkd__btn--g{background:var(--g);box-shadow:0 4px 0 #0B2117}
  .wkd__btn--line{background:#fff;color:var(--g)!important;border:1.5px solid var(--g);box-shadow:none}
  .wkd__btn--line:hover{transform:none;background:var(--mint)}
  .wkd__btn svg{flex:none}
  .wkd__ph{border-radius:16px;overflow:hidden;background:var(--soft)}
  .wkd__ic{flex:none;color:var(--leaf2)}

  /* hero */
  .wkd__hero{background:linear-gradient(180deg,var(--cream) 0%,#fff 100%);padding:48px 0 72px}
  .wkd__hero-g{display:grid;grid-template-columns:1fr 1.05fr;gap:48px;align-items:center}
  .wkd__tag{display:inline-flex;align-items:center;gap:8px;margin:0 0 18px;padding:6px 14px;border-radius:999px;background:var(--mint);color:var(--g);font-size:13px;font-weight:700}
  .wkd__h1{margin:0;font-family:var(--serif);font-weight:400;color:var(--g);font-size:clamp(34px,4.8vw,56px);line-height:1.4}
  .wkd__h1 em{font-style:normal;color:var(--leaf2)}
  .wkd__hero-p{margin:20px 0 28px;font-size:17px;max-width:520px}
  .wkd__offer{background:#fff;border:2px solid var(--g);border-radius:20px;padding:22px 24px;max-width:520px;box-shadow:0 12px 28px rgba(22,55,41,.10);position:relative}
  .wkd__offer-flag{position:absolute;top:-14px;left:20px;background:var(--g);color:#fff;font-size:12px;font-weight:700;padding:4px 12px;border-radius:999px;letter-spacing:.08em}
  .wkd__offer-row{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap}
  .wkd__offer-name{margin:0;font-weight:700;color:var(--g);font-size:17px}
  .wkd__offer-name small{display:block;font-weight:500;color:var(--mute);font-size:13px}
  .wkd__offer-price{margin:0;font-size:36px;font-weight:700;color:var(--g);line-height:1.1}
  .wkd__offer-price span{font-size:13px;font-weight:500;color:var(--mute);margin-left:4px}
  .wkd__offer ul{margin:14px 0 18px;padding:0;list-style:none;display:grid;gap:6px;font-size:14px}
  .wkd__offer li{display:flex;gap:8px;align-items:flex-start}
  .wkd__offer .wkd__btn{width:100%}
  .wkd__offer-sub{margin:10px 0 0;font-size:13px;text-align:center}
  .wkd__hero-ph{position:relative}
  .wkd__hero-ph .wkd__ph{aspect-ratio:5/4;border-radius:24px}
  .wkd__hero-mini{position:absolute;left:-28px;bottom:-28px;width:38%;aspect-ratio:1;border:6px solid #fff;border-radius:20px}
  .wkd__trust{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:56px}
  .wkd__trust div{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px 12px;text-align:center}
  .wkd__trust b{display:block;font-size:28px;line-height:1.2;color:var(--g)} .wkd__trust b span{font-size:14px}
  .wkd__trust p{margin:4px 0 0;font-size:13px;color:var(--mute);line-height:1.5}

  /* promises */
  .wkd__prom{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
  .wkd__prom>div{display:flex;gap:14px;align-items:flex-start;background:#fff;border-radius:16px;padding:20px;border:1px solid var(--line)}
  .wkd__prom b{display:block;color:var(--g);font-size:16px;line-height:1.5}
  .wkd__prom p{margin:4px 0 0;font-size:13px;color:var(--mute);line-height:1.7}
  .wkd__prom .wkd__ic{width:40px;height:40px;padding:8px;border-radius:12px;background:var(--mint)}

  /* weekly */
  .wkd__week{display:grid;grid-template-columns:1fr 1fr;gap:0;border-radius:24px;overflow:hidden;background:#fff;box-shadow:0 10px 30px rgba(62,58,52,.08)}
  .wkd__week .wkd__ph{border-radius:0;min-height:360px}
  .wkd__week-b{padding:44px}
  .wkd__week-date{display:inline-block;margin:0 0 14px;padding:4px 12px;border-radius:8px;background:var(--cream);font-size:13px;font-weight:700;color:var(--carrot)}
  .wkd__chips{display:flex;flex-wrap:wrap;gap:10px;margin:18px 0}
  .wkd__chips span{padding:8px 16px;border-radius:999px;background:var(--mint);color:var(--g);font-weight:700;font-size:15px}
  .wkd__chips span.more{background:transparent;border:1.5px dashed var(--leaf2)}
  .wkd__live{display:inline-flex;align-items:center;gap:6px;margin-left:8px;font-size:12px;font-weight:700;color:var(--leaf2)}
  .wkd__live::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--leaf);box-shadow:0 0 0 4px rgba(130,188,63,.25)}
  .wkd__week-note{font-size:14px;color:var(--mute);margin:0 0 20px}

  /* standards */
  .wkd__std{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:start}
  .wkd__table{width:100%;border-collapse:separate;border-spacing:0;background:#fff;border-radius:18px;overflow:hidden;border:1px solid var(--line)}
  .wkd__table th,.wkd__table td{padding:16px 18px;text-align:left;font-size:15px;border-bottom:1px solid var(--line);vertical-align:top}
  .wkd__table tr:last-child th,.wkd__table tr:last-child td{border-bottom:0}
  .wkd__table th{width:42%;font-weight:700;color:var(--g);background:#FCFBF8}
  .wkd__yes,.wkd__no,.wkd__part{display:inline-flex;align-items:center;gap:6px;font-weight:700}
  .wkd__no{color:var(--g2)} .wkd__yes{color:var(--carrot)} .wkd__part{color:#9A7B2F}
  .wkd__table small{display:block;font-weight:400;color:var(--mute);font-size:13px;margin-top:2px}
  .wkd__std-note{margin:14px 0 0;font-size:13px;color:var(--mute)}
  .wkd__seed{background:var(--g);color:#fff;border-radius:20px;padding:32px}
  .wkd__seed h3{margin:0 0 12px;font-family:var(--serif);font-weight:400;font-size:22px;color:#fff}
  .wkd__seed p{margin:0 0 14px;font-size:15px;color:#E4EEE0}
  .wkd__seed .wkd__ph{aspect-ratio:16/10;margin-top:8px}

  /* lab */
  .wkd__lab{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
  .wkd__labc{background:#fff;border-radius:18px;padding:24px 20px;border:1px solid var(--line)}
  .wkd__labc h3{margin:0 0 2px;font-size:16px;color:var(--g)}
  .wkd__labc .u{font-size:12px;color:var(--mute)}
  .wkd__labc .big{margin:12px 0 14px;font-size:30px;font-weight:700;color:var(--carrot);line-height:1.1}
  .wkd__labc .big span{font-size:14px;color:var(--mute);font-weight:500}
  .wkd__lrow{display:flex;align-items:center;gap:8px;font-size:12px;margin-top:8px}
  .wkd__lrow>span:first-child{width:52px;flex:none;color:var(--mute)}
  .wkd__ltrack{flex:1;height:12px;border-radius:999px;background:var(--soft);overflow:hidden}
  .wkd__lfill{display:block!important;height:100%;border-radius:999px;background:var(--leaf)}
  .wkd__ph:empty{display:block}
  .wkd__lfill.avg{background:#CFC8BB}
  .wkd__lrow>span:last-child{width:48px;flex:none;text-align:right;font-weight:700}
  .wkd__src{margin:18px 0 0;font-size:13px;color:var(--mute)}

  /* plans */
  .wkd__plans{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;max-width:960px;margin:0 auto}
  .wkd__plan{background:#fff;border:1px solid var(--line);border-radius:22px;padding:32px;display:flex;flex-direction:column;position:relative}
  .wkd__plan--rec{border:2px solid var(--carrot)}
  .wkd__plan-flag{position:absolute;top:-14px;right:24px;background:var(--carrot);color:#fff;font-size:12px;font-weight:700;padding:4px 12px;border-radius:999px}
  .wkd__plan h3{margin:0;font-size:20px;color:var(--g)}
  .wkd__plan .who{margin:4px 0 16px;font-size:14px;color:var(--mute)}
  .wkd__plan .pr{margin:0 0 16px;font-size:32px;font-weight:700;color:var(--g);line-height:1.2}
  .wkd__plan .pr span{font-size:13px;font-weight:500;color:var(--mute)}
  .wkd__plan ul{margin:0 0 24px;padding:0;list-style:none;display:grid;gap:8px;font-size:15px;flex:1}
  .wkd__plan li{display:flex;gap:8px;align-items:flex-start}
  .wkd__freq{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 16px}
  .wkd__freq span{padding:4px 12px;border-radius:8px;background:var(--soft);font-size:13px;font-weight:700;color:var(--g)}
  .wkd__ship{max-width:960px;margin:32px auto 0;background:#fff;border-radius:18px;border:1px solid var(--line);padding:24px 28px}
  .wkd__ship h3{margin:0 0 12px;font-size:16px;color:var(--g)}
  .wkd__ship-g{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px 20px;font-size:14px}
  .wkd__ship-g div{display:flex;justify-content:space-between;border-bottom:1px dotted var(--line);padding:4px 0}
  .wkd__ship p{margin:12px 0 0;font-size:13px;color:var(--mute)}

  /* flow */
  .wkd__flow{margin:0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;counter-reset:f}
  .wkd__flow li{background:#fff;border-radius:18px;overflow:hidden;border:1px solid var(--line);counter-increment:f;position:relative}
  .wkd__flow .wkd__ph{border-radius:0;aspect-ratio:4/3}
  .wkd__flow li::before{content:"STEP " counter(f);position:absolute;top:12px;left:12px;z-index:1;background:#fff;color:var(--g);font-size:12px;font-weight:700;padding:3px 10px;border-radius:999px}
  .wkd__flow div.t{padding:18px 20px 22px}
  .wkd__flow b{display:block;color:var(--g);font-size:16px}
  .wkd__flow p{margin:6px 0 0;font-size:14px;color:var(--mute);line-height:1.75}

  /* products */
  .wkd__prods{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}
  .wkd__prod{text-decoration:none;color:var(--ink)!important;background:#fff;border-radius:18px;overflow:hidden;border:1px solid var(--line);transition:transform .2s}
  .wkd__prod:hover{transform:translateY(-3px)}
  .wkd__prod .wkd__ph{border-radius:0;aspect-ratio:1}
  .wkd__prod div.t{padding:14px 16px 18px}
  .wkd__prod b{display:block;font-size:15px;line-height:1.5;color:var(--g)}
  .wkd__prod span{font-size:14px;font-weight:700}

  /* people */
  .wkd__people{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
  .wkd__people .wkd__ph{aspect-ratio:4/3;border-radius:24px}
  .wkd__time{margin:0;padding:0;list-style:none;border-left:2px solid var(--leaf);padding-left:22px;display:grid;gap:18px}
  .wkd__time li{position:relative}
  .wkd__time li::before{content:"";position:absolute;left:-29px;top:8px;width:12px;height:12px;border-radius:50%;background:#fff;border:3px solid var(--leaf)}
  .wkd__time b{color:var(--g);font-size:15px}
  .wkd__time p{margin:2px 0 0;font-size:14px;color:var(--mute)}
  .wkd__links{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}

  /* voices */
  .wkd__voices{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
  .wkd__voice{background:#fff;border-radius:18px;padding:28px;border:1px solid var(--line);margin:0}
  .wkd__stars{color:#E9A93A;letter-spacing:2px;font-size:15px}
  .wkd__voice p{margin:10px 0 14px;font-size:15px}
  .wkd__voice cite{font-style:normal;font-size:13px;color:var(--mute)}

  /* journal */
  .wkd__jr{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
  .wkd__jr a{display:block;text-decoration:none;color:var(--ink)!important;background:#fff;border-radius:18px;overflow:hidden;border:1px solid var(--line);transition:transform .2s}
  .wkd__jr a:hover{transform:translateY(-3px)}
  .wkd__jr .wkd__ph{border-radius:0;aspect-ratio:3/2}
  .wkd__jr .t{padding:16px 18px 20px}
  .wkd__jr time{font-size:12px;color:var(--mute)}
  .wkd__jr b{display:block;margin-top:4px;font-size:16px;line-height:1.6;color:var(--g)}
  .wkd__jr .tg{display:inline-block;margin-top:8px;font-size:12px;padding:2px 10px;border-radius:999px;background:var(--mint);color:var(--g)}
  .wkd__jr-h{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:28px}

  /* faq */
  .wkd__faq{max-width:820px;margin:0 auto;display:grid;gap:12px}
  .wkd__faq details{background:#fff;border:1px solid var(--line);border-radius:14px;padding:0 22px}
  .wkd__faq summary{cursor:pointer;list-style:none;padding:18px 28px 18px 0;font-weight:700;color:var(--g);position:relative}
  .wkd__faq summary::-webkit-details-marker{display:none}
  .wkd__faq summary::before{content:"Q.";color:var(--carrot);margin-right:8px}
  .wkd__faq summary::after{content:"+";position:absolute;right:0;top:14px;font-size:22px;color:var(--leaf2)}
  .wkd__faq details[open] summary::after{content:"−"}
  .wkd__faq details p{margin:0 0 18px;color:var(--ink);font-size:15px}

  /* final */
  .wkd__final{background:var(--g);color:#fff;border-radius:28px;padding:56px;display:grid;grid-template-columns:1.2fr .8fr;gap:40px;align-items:center}
  .wkd__final h2{margin:0 0 12px;font-family:var(--serif);font-weight:400;font-size:clamp(24px,3vw,34px);color:#fff;line-height:1.5}
  .wkd__final p{margin:0;color:#DCE8D6}
  .wkd__final .wkd__ph{aspect-ratio:1;border-radius:50%;max-width:260px;margin-left:auto;border:6px solid rgba(255,255,255,.15)}
  .wkd__final-cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}

  /* sticky */
  .wkd__sticky{position:fixed;left:0;right:0;bottom:0;z-index:50;background:rgba(255,255,255,.96);backdrop-filter:blur(6px);border-top:1px solid var(--line);padding:10px 16px calc(10px + env(safe-area-inset-bottom));display:none;align-items:center;justify-content:space-between;gap:12px}
  .wkd__sticky p{margin:0;font-size:13px;line-height:1.4;color:var(--g)} .wkd__sticky b{font-size:16px}
  .wkd__sticky .wkd__btn{min-height:46px;padding:0 20px;font-size:15px}
  .wkd__sticky{transform:translateY(110%);transition:transform .25s}
  .wkd__sticky.is-on{transform:none}

  @media (max-width:989px){
    .wkd__sec{padding:72px 0}
    .wkd__hero-g,.wkd__std,.wkd__people,.wkd__week,.wkd__final{grid-template-columns:1fr}
    .wkd__hero-ph{order:-1}
    .wkd__hero-mini{left:auto;right:12px;bottom:-20px;width:32%}
    .wkd__trust,.wkd__prom,.wkd__lab,.wkd__prods{grid-template-columns:repeat(2,minmax(0,1fr))}
    .wkd__flow{grid-template-columns:repeat(2,minmax(0,1fr))}
    .wkd__voices{grid-template-columns:1fr}
    .wkd__jr{grid-template-columns:1fr}
    .wkd__ship-g{grid-template-columns:repeat(2,minmax(0,1fr))}
    .wkd__week-b{padding:28px}
    .wkd__week .wkd__ph{min-height:240px}
    .wkd__final{padding:36px 24px}
    .wkd__final .wkd__ph{display:none}
    .wkd__sticky{display:flex}
    .wkd{padding-bottom:72px}
  }
  @media (max-width:640px){
    .wkd__in{padding:0 16px}
    .wkd__plans{grid-template-columns:1fr}
    .wkd__flow{grid-template-columns:1fr}
    .wkd__table th{width:38%}
    .wkd__table th,.wkd__table td{padding:14px 12px;font-size:14px}
    .wkd__offer{padding:20px 18px}
    .wkd__prom{grid-template-columns:1fr}
    .wkd__h1{font-size:32px}
    .wkd__week-b .wkd__h2{font-size:22px!important}
    .wkd__week-b .wkd__btn,.wkd__links .wkd__btn,.wkd__jr-h .wkd__btn,.wkd__final-cta .wkd__btn{width:100%}
    .wkd__trust b{font-size:24px}
  }
</style>

{%- liquid
  assign s = section.settings
  assign month = 'now' | date: '%m' | plus: 0
  assign trial_handle = s.trial_product
  assign trial_season = '常温便（11〜3月）'
  if month >= 4 and month <= 10
    assign trial_handle = s.trial_product_summer
    assign trial_season = '冷蔵便（4〜10月）'
  endif
  assign trial = all_products[trial_handle]
  assign trial_url = s.trial_link
  if trial_url == blank and trial != blank
    assign trial_url = trial.url
  endif
  if trial_url == blank
    assign trial_url = '/collections/all'
  endif
  assign trial_price = s.trial_price
  if trial != blank
    assign trial_price = trial.price | money_without_trailing_zeros
  endif
  assign delivery_url = s.delivery_link | default: '/pages/delivery'
  assign week_url = s.week_link
  if week_url == blank
    assign week_url = blogs['ニュース'].url | default: '/blogs'
  endif
-%}

{%- capture ic_check -%}<svg class="wkd__ic" aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="margin-top:4px"><path d="M4 10.5l4 4 8-9"/></svg>{%- endcapture -%}
{%- capture ic_arrow -%}<svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h12M11 5l5 5-5 5"/></svg>{%- endcapture -%}

<div class="wkd">

  {%- comment -%} 1. ヒーロー：お試しの条件を最初に見せる {%- endcomment -%}
  <section class="wkd__hero">
    <div class="wkd__in">
      <div class="wkd__hero-g">
        <div>
          <p class="wkd__tag"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 27V15"/><path d="M16 17c0-5 3.6-8.5 8.5-8.5 0 5-3.6 8.5-8.5 8.5z"/><path d="M16 21c0-4-3-7-7-7 0 4 3 7 7 7z"/></svg>{{ s.hero_tag }}</p>
          <h1 class="wkd__h1">{{ s.hero_title | newline_to_br }}</h1>
          <p class="wkd__hero-p">{{ s.hero_text }}</p>
          <div class="wkd__offer">
            <span class="wkd__offer-flag">はじめての方へ</span>
            <div class="wkd__offer-row">
              <p class="wkd__offer-name">{{ s.trial_name }}<small>{{ s.trial_sub }}</small></p>
              <p class="wkd__offer-price">{{ trial_price }}<span>税込・送料別</span></p>
            </div>
            <ul>
              <li>{{ ic_check }}定期のお申し込みは不要。1回だけのお届けです</li>
              <li>{{ ic_check }}その時いちばんおいしい季節の野菜を約8品目</li>
