      {%- capture faq_ld -%}{%- for block in section.blocks -%}{%- if block.type == 'faq' -%}{"@type":"Question","name":{{ block.settings.q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.a | json }}}},{%- endif -%}{%- endfor -%}{%- endcapture -%}
      <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ faq_ld | remove_last: ',' }}]}</script>
    </div>
  </section>

  {%- comment -%} 12. 最後のひと押し {%- endcomment -%}
  <section class="wkd__sec" style="padding-top:0">
    <div class="wkd__in">
      <div class="wkd__final">
        <div>
          <h2>まずは一箱、畑の味を。</h2>
          <p>甘さ、香り、歯ごたえ。肥料も農薬も使わずに育った野菜の「本来の味」を、ご家庭でたしかめてください。</p>
          <div class="wkd__final-cta">
            <a class="wkd__btn" href="{{ trial_url }}">{{ s.cta_label }}{{ ic_arrow }}</a>
            <a class="wkd__btn wkd__btn--line" href="/pages/contact" style="background:transparent;color:#fff!important;border-color:rgba(255,255,255,.6)">お問い合わせ</a>
          </div>
        </div>
        <div class="wkd__ph">{% if s.final_image != blank %}{{ s.final_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,600', alt: s.final_image.alt }}{% endif %}</div>
      </div>
    </div>
  </section>

  {%- comment -%} スマホ用：画面下に固定の申し込みボタン {%- endcomment -%}
  <div class="wkd__sticky" aria-hidden="true">
    <p>お試し1回 <b>{{ trial_price }}</b><br>定期申し込み不要</p>
    <a class="wkd__btn" href="{{ trial_url }}" tabindex="-1">申し込む</a>
  </div>
</div>
<script>
  (function(){
    var bar=document.querySelector('.wkd__sticky'),offer=document.querySelector('.wkd__offer'),fin=document.querySelector('.wkd__final');
    if(!bar||!offer||!('IntersectionObserver' in window))return;
    var seen={offer:true,fin:false};
    function upd(){var on=!seen.offer&&!seen.fin;bar.classList.toggle('is-on',on);bar.setAttribute('aria-hidden',on?'false':'true');bar.querySelector('a').tabIndex=on?0:-1;}
    new IntersectionObserver(function(es){es.forEach(function(e){seen[e.target===offer?'offer':'fin']=e.isIntersecting;});upd();}).observe(offer);
    if(fin){new IntersectionObserver(function(es){es.forEach(function(e){seen.fin=e.isIntersecting;});upd();}).observe(fin);}
  })();
</script>

