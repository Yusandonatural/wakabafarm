    { "type": "text", "id": "plan_2_name", "label": "商品 2 の名前（非公開時の表示）", "default": "お試しセット 冷蔵便" },
    { "type": "text", "id": "plan_2_price", "label": "商品 2 の価格（非公開時の表示）", "default": "¥4,328" }
  ],
  "blocks": [
