    { "type": "image_picker", "id": "box_image", "label": "届くまで の写真（大）" },
    { "type": "image_picker", "id": "box_image_2", "label": "届くまで の写真（小）" },
    { "type": "image_picker", "id": "season_1", "label": "旬：春 の写真" },
    { "type": "image_picker", "id": "season_2", "label": "旬：夏 の写真" },
    { "type": "image_picker", "id": "season_3", "label": "旬：秋 の写真" },
    { "type": "image_picker", "id": "season_4", "label": "旬：冬 の写真" },
    { "type": "image_picker", "id": "offer_image", "label": "お試しセット の写真" },
    { "type": "header", "content": "お試しセット" },
